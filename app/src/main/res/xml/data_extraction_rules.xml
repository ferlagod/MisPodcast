<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Excluir DataStore de preferencias para que las credenciales de Nextcloud no viajen a la nube de Google -->
        <exclude domain="file" path="datastore" />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <!-- Transferencia directa entre dispositivos: sin reglas se copia todo (base de datos con suscripciones,
         cola e historial, y ajustes). Un <include> aquí actuaría como lista blanca y dejaría fuera la base
         de datos. La contraseña de Nextcloud viaja cifrada con una clave del KeyStore que no se transfiere,
         así que habrá que volver a introducirla en el dispositivo nuevo. -->
    <device-transfer />
</data-extraction-rules>
